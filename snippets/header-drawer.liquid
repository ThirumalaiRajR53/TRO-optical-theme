{% comment %}
Renders a header drawer menu for mobile and desktop.

Usage:
{% render 'header-drawer' %}
{% endcomment %}

<header-drawer data-breakpoint="{% if section.settings.menu_type_desktop == 'drawer' %}desktop{% else %}tablet{% endif %}">
  <details id="Details-menu-drawer-container" class="menu-drawer-container">
    <summary class="header__icon header__icon--menu header__icon--summary header__hamburger link focus-inset" aria-label="{{ 'sections.header.menu' | t }}">
      <span>
        {% render 'icon-hamburger' %}
        {% render 'icon-close' %}
      </span>
    </summary>
    <div
      id="menu-drawer"
      class="gradient menu-drawer motion-reduce"
      tabindex="-1">
      <div class="menu-drawer__header">
        <span class="header__icon header__icon--menu header__icon--summary link focus-inset twcss-mx-4"> {% render 'icon-close-xl' %}</span>

        {%- if request.page_type == 'index' -%}
          <div class="header__heading">
          {%- endif -%}
          {% render 'header-logo' %}
          {%- if request.page_type == 'index' -%}
          </div>
        {%- endif -%}
        {% comment %} commented this to remove search icon from sidebar menu, It might be needed later {% endcomment %}
        {% comment %} <span class="menu-drawer__search-wrapper">{% render 'header-search', input_id: 'Search-In-Modal' %}</span> {% endcomment %}
      </div>

      <div class="menu-drawer__inner-container">
        <div class="menu-drawer__navigation-container">
          <nav class="menu-drawer__navigation">
            <ul class="menu-drawer__menu has-submenu list-menu" role="list">
              {%- for link in section.settings.menu.links -%}
                <li>
                  {%- if link.links != blank -%}
                    <details id="Details-menu-drawer-menu-item-{{ forloop.index }}">
                      <summary class="menu-drawer__menu-item list-menu__item link focus-inset{% if link.child_active %} menu-drawer__menu-item--active{% endif %}">
                        {{ link.title | escape }}
                        {% render 'icon-caret' %}
                      </summary>
                      <div
                        id="link-{{ link.handle | escape }}"
                        class="menu-drawer__submenu has-submenu gradient motion-reduce"
                        tabindex="-1">
                        <div class="menu-drawer__inner-submenu">
                          <button class="menu-drawer__close-button link focus-inset" aria-expanded="true">
                            {% render 'icon-caret' %}
                            {{ link.title | escape }}
                          </button>
                          <ul
                            class="menu-drawer__menu menu-drawer__menu--level-2"
                            role="list"
                            tabindex="-1">
                            {%- for childlink in link.links -%}
                              <li>
                                {%- if childlink.links == blank -%}
                                  <a
                                    href="{{ childlink.url }}"
                                    class="menu-drawer__menu-item link list-menu__item focus-inset{% if childlink.current %} menu-drawer__menu-item--active{% endif %}"
                                    {% if childlink.current %}aria-current="page"{% endif %}>
                                    {{ childlink.title | escape }}
                                  </a>
                                {%- else -%}
                                  <span class="menu-drawer__menu-item--title">
                                    {{ childlink.title | escape }}
                                  </span>
                                  <ul
                                    class="menu-drawer__menu menu-drawer__menu--level-3"
                                    role="list"
                                    tabindex="-1">
                                    {%- for grandchildlink in childlink.links -%}
                                      <li>
                                        <a
                                          href="{{ grandchildlink.url }}"
                                          class="menu-drawer__menu-item link list-menu__item focus-inset{% if grandchildlink.current %} menu-drawer__menu-item--active{% endif %}"
                                          {% if grandchildlink.current %}aria-current="page"{% endif %}>
                                          {{ grandchildlink.title | escape }}
                                        </a>
                                      </li>
                                    {%- endfor -%}
                                  </ul>
                                {%- endif -%}
                              </li>
                            {%- endfor -%}
                          </ul>
                          <div class="menu-drawer__images-wrapper">
                            {% assign counter = 0 %}
                            {% for block in section.blocks %}
                              {% if block.settings.top-menu-name != blank %}
                                {% if link.title == block.settings.top-menu-name %}
                                  {% assign counter = counter | plus: 1 %}
                                  {% if counter <= 2 %}
                                    <div class="menu-drawer__image-block">
                                      <a href="{{ block.settings.link }}">
                                        <div class="menu-drawer__image-wrapper">
                                          <img
                                            src="{{ block.settings.image | image_url: width: 400 }}"
                                            alt="{{ block.settings.image.alt | escape }}"
                                            loading="lazy"
                                            width="400"
                                            height="300"
                                          >
                                        </div>
                                        <div class="menu-drawer__image-block-info">
                                          <span class="menu-drawer__image-heading twcss-block twcss-font-semibold">{{ block.settings.heading }}</span>
                                          <span class="menu-drawer__image-subheading twcss-block twcss-font-semibold">{{ block.settings.subheading | upcase }}</span>
                                        </div>
                                      </a>
                                    </div>
                                  {% endif %}
                                {% endif %}
                              {% endif %}
                            {% endfor %}
                          </div>
                        </div>
                      </div>
                    </details>
                  {%- else -%}
                    {%- assign drawer_link_lower = link.title | downcase -%}
                    {%- if drawer_link_lower == 'browse' or drawer_link_lower == 'catalog' -%}
                      <details id="Details-menu-drawer-explore-{{ forloop.index }}">
                        <summary class="menu-drawer__menu-item list-menu__item link focus-inset">
                          Explore
                          {% render 'icon-caret' %}
                        </summary>
                        <div class="menu-drawer__submenu gradient motion-reduce" tabindex="-1">
                          <div class="menu-drawer__inner-submenu">
                            <button class="menu-drawer__close-button link focus-inset" aria-expanded="true">
                              {% render 'icon-caret' %}
                              Explore
                            </button>
                            <ul class="menu-drawer__menu menu-drawer__menu--level-2" role="list" tabindex="-1">
                              <li><a href="{{ routes.collections_url }}/eyeglasses" class="menu-drawer__menu-item link list-menu__item focus-inset">Eyeglasses</a></li>
                              <li><a href="{{ routes.collections_url }}/sunglasses" class="menu-drawer__menu-item link list-menu__item focus-inset">Sunglasses</a></li>
                              <li><a href="{{ routes.collections_url }}/contact-lenses" class="menu-drawer__menu-item link list-menu__item focus-inset">Contact Lenses</a></li>
                              <li><a href="{{ routes.collections_url }}/reading-glasses" class="menu-drawer__menu-item link list-menu__item focus-inset">Reading Glasses</a></li>
                              <li><a href="{{ routes.collections_url }}/accessories" class="menu-drawer__menu-item link list-menu__item focus-inset">Accessories</a></li>
                            </ul>
                          </div>
                        </div>
                      </details>
                    {%- elsif drawer_link_lower == 'brands' or drawer_link_lower == 'contact' -%}
                      <details id="Details-menu-drawer-brands-{{ forloop.index }}">
                        <summary class="menu-drawer__menu-item list-menu__item link focus-inset">
                          Brands
                          {% render 'icon-caret' %}
                        </summary>
                        <div class="menu-drawer__submenu gradient motion-reduce" tabindex="-1">
                          <div class="menu-drawer__inner-submenu">
                            <button class="menu-drawer__close-button link focus-inset" aria-expanded="true">
                              {% render 'icon-caret' %}
                              Brands
                            </button>
                            <ul class="menu-drawer__menu menu-drawer__menu--level-2" role="list" tabindex="-1">
                              <li><a href="{{ routes.all_products_collection_url }}?filter.p.vendor=IDEE" class="menu-drawer__menu-item link list-menu__item focus-inset">IDEE</a></li>
                              <li><a href="{{ routes.all_products_collection_url }}?filter.p.vendor=IRUS" class="menu-drawer__menu-item link list-menu__item focus-inset">IRUS</a></li>
                              <li><a href="{{ routes.all_products_collection_url }}?filter.p.vendor=FILA" class="menu-drawer__menu-item link list-menu__item focus-inset">FILA</a></li>
                              <li><a href="{{ routes.all_products_collection_url }}?filter.p.vendor=POLICE" class="menu-drawer__menu-item link list-menu__item focus-inset">POLICE</a></li>
                              <li><a href="{{ routes.all_products_collection_url }}?filter.p.vendor=Acuvue" class="menu-drawer__menu-item link list-menu__item focus-inset">Acuvue</a></li>
                              <li><a href="{{ routes.all_products_collection_url }}?filter.p.vendor=Bausch%2BLomb" class="menu-drawer__menu-item link list-menu__item focus-inset">Bausch+Lomb</a></li>
                              <li><a href="{{ routes.all_products_collection_url }}?filter.p.vendor=Celebration" class="menu-drawer__menu-item link list-menu__item focus-inset">Celebration</a></li>
                              <li><a href="{{ routes.all_products_collection_url }}?filter.p.vendor=PolyLite" class="menu-drawer__menu-item link list-menu__item focus-inset">PolyLite</a></li>
                              <li><a href="{{ routes.all_products_collection_url }}?filter.p.vendor=CooperVision" class="menu-drawer__menu-item link list-menu__item focus-inset">CooperVision</a></li>
                              <li><a href="{{ routes.all_products_collection_url }}?filter.p.vendor=Alcon" class="menu-drawer__menu-item link list-menu__item focus-inset">Alcon</a></li>
                            </ul>
                          </div>
                        </div>
                      </details>
                    {%- else -%}
                      <a
                        href="{{ link.url }}"
                        class="menu-drawer__menu-item list-menu__item link focus-inset{% if link.current %} menu-drawer__menu-item--active{% endif %}"
                        {% if link.current %}aria-current="page"{% endif %}>
                        {{ link.title | escape }}
                      </a>
                    {%- endif -%}
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          </nav>
          {%- if shop.customer_accounts_enabled -%}
            <div class="menu-drawer__utility-links">
              <a
                href="{{ routes.account_url }}"
                class="menu-drawer__account link focus-inset"
                rel="nofollow"
              >
                {% render 'icon-account' %}
                <span>{{ 'customer.account_fallback' | t }}</span>
              </a>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </details>
</header-drawer>