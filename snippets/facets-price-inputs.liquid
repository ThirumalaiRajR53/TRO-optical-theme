{%- comment -%}
  Renders the min/max inputs of a price_range filter.

  Accepts:
  - filter: {Object} price_range filter object
  - id_prefix: {String} 'Filter-' (desktop) or 'Mobile-Filter-' (drawer)
  - filter_type: {String} 'horizontal' | 'vertical' | 'drawer'
  - mobile: {Boolean} Drawer variant: numeric keypad hint and a currency symbol before both fields

  Usage:
  {% render 'facets-price-inputs', filter: filter, id_prefix: 'Filter-', filter_type: filter_type %}
{%- endcomment -%}
{%- liquid
  assign currencies_using_comma_decimals = 'ANG,ARS,BRL,BYN,BYR,CLF,CLP,COP,CRC,CZK,DKK,EUR,HRK,HUF,IDR,ISK,MZN,NOK,PLN,RON,RUB,SEK,TRY,UYU,VES,VND' | split: ','
  assign thousands_separator = ','
  assign decimal_separator = '.'
  if currencies_using_comma_decimals contains cart.currency.iso_code
    assign thousands_separator = '.'
    assign decimal_separator = ','
  endif
  assign range_max = filter.range_max | money_without_currency | replace: thousands_separator, '' | replace: decimal_separator, '.'
  assign field_id = filter.label | escape | prepend: id_prefix
-%}
<price-range class="facets__price">
  <span class="field-currency">{{ cart.currency.symbol }}</span>
  <div class="field">
    <input
      class="field__input"
      name="{{ filter.min_value.param_name }}"
      id="{{ field_id }}-GTE"
      {% if filter.min_value.value %}
        value="{{ filter.min_value.value | money_without_currency | replace: thousands_separator, '' | replace: decimal_separator, '.' }}"
      {% endif %}
      type="number"
      placeholder="0"
      min="0"
      {% if mobile %}
        inputmode="decimal"
      {% endif %}
      max="{{ range_max }}"
    >
  </div>
  {%- if mobile or filter_type != 'vertical' %}
    <span class="field-currency">{{ cart.currency.symbol }}</span>
  {%- endif %}
  <div class="field">
    <input
      class="field__input"
      name="{{ filter.max_value.param_name }}"
      id="{{ field_id }}-LTE"
      {% if filter.max_value.value %}
        value="{{ filter.max_value.value | money_without_currency | replace: thousands_separator, '' | replace: decimal_separator, '.' }}"
      {% endif %}
      type="number"
      min="0"
      {% if mobile %}
        inputmode="decimal"
      {% endif %}
      placeholder="{{ range_max }}"
      max="{{ range_max }}"
    >
  </div>
</price-range>
