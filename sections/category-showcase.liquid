<section class="category-showcase section-{{ section.id }}-padding">
  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }

    .category-showcase {
      text-align: center;
    }

    .category-showcase__title {
      margin: 0 0 0.5rem;
      color: var(--tro-ink);
    }

    .category-showcase__subtitle {
      margin: 0 0 2.25rem;
      font-size: 1rem;
      color: var(--tro-muted);
    }

    .category-showcase__grid {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 0.75rem;
      max-width: 72rem;
      margin: 0 auto;
    }

    .category-showcase__item {
      display: flex;
      flex-direction: column;
      align-items: center;
      min-width: 0;
      text-decoration: none;
      transition: transform var(--tro-dur) var(--tro-ease);
    }

    .category-showcase__item:hover {
      transform: translateY(-4px);
    }

    .category-showcase__image-wrapper {
      position: relative;
      width: 100%;
      max-width: 11rem;
      aspect-ratio: 1;
      border-radius: 50%;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--tro-linen);
      box-shadow: 0 0 0 1px rgba(18, 26, 74, 0.08), 0 24px 40px -28px rgba(11, 19, 64, 0.45);
      transition: box-shadow var(--tro-dur) var(--tro-ease);
    }

    .category-showcase__image-wrapper::after {
      content: "";
      position: absolute;
      inset: 0;
      border-radius: 50%;
      box-shadow: inset 0 0 0 5px rgba(255, 255, 255, 0.55);
      pointer-events: none;
    }

    .category-showcase__item:hover .category-showcase__image-wrapper {
      box-shadow: 0 0 0 1px rgba(18, 26, 74, 0.14), 0 28px 44px -24px rgba(11, 19, 64, 0.55);
    }

    .category-showcase__image-wrapper img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform var(--tro-dur-slow) var(--tro-ease);
    }

    .category-showcase__item:hover .category-showcase__image-wrapper img {
      transform: scale(1.05);
    }

    .category-showcase__image-wrapper svg {
      width: 40%;
      height: 40%;
      color: var(--tro-indigo);
    }

    .category-showcase__label {
      margin-top: 1rem;
      font-family: var(--font-body-family);
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--tro-ink);
    }

    @media screen and (min-width: 750px) {
      .category-showcase__grid {
        gap: 1.75rem;
      }

      .category-showcase__label {
        font-size: 0.8125rem;
      }
    }

    @media screen and (max-width: 749px) {
      .category-showcase__image-wrapper::after {
        box-shadow: inset 0 0 0 3px rgba(255, 255, 255, 0.55);
      }

      .category-showcase__label {
        font-size: 0.5625rem;
        letter-spacing: 0.04em;
        margin-top: 0.6rem;
      }
    }
  {%- endstyle -%}

  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="category-showcase__title">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.subtitle != blank -%}
      <p class="category-showcase__subtitle">{{ section.settings.subtitle }}</p>
    {%- endif -%}

    <div class="category-showcase__grid">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link }}" class="category-showcase__item" {{ block.shopify_attributes }}>
          <div class="category-showcase__image-wrapper">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 520
                | image_tag:
                  widths: '180, 260, 360, 520',
                  sizes: '(min-width: 750px) 176px, 20vw',
                  width: 176,
                  height: 176,
                  loading: 'lazy',
                  alt: ''
              }}
            {%- else -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/>
                <circle cx="12" cy="12" r="3"/>
              </svg>
            {%- endif -%}
          </div>
          <span class="category-showcase__label">{{ block.settings.label }}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Category Showcase",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "Shop By Category",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "subtitle",
      "default": "Find the perfect eyewear for every need",
      "label": "Subtitle"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "label",
          "default": "Category",
          "label": "Label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Category Showcase",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "label": "Eyeglasses"
          }
        },
        {
          "type": "category",
          "settings": {
            "label": "Sunglasses"
          }
        },
        {
          "type": "category",
          "settings": {
            "label": "Contact Lenses"
          }
        },
        {
          "type": "category",
          "settings": {
            "label": "Reading Glasses"
          }
        },
        {
          "type": "category",
          "settings": {
            "label": "Accessories"
          }
        }
      ]
    }
  ]
}
{% endschema %}
