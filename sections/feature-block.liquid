{{ 'section-feature-block.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="feature-block feature-block--{{ section.settings.image_height }}">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'column' -%}
            {%- assign tile_tag = 'div' -%}
            {%- if block.settings.button_link != blank -%}
              {%- assign tile_tag = 'a' -%}
            {%- endif -%}
            <{{ tile_tag }}
              {% if tile_tag == 'a' %}href="{{ block.settings.button_link }}"{% endif %}
              class="feature-tile feature-tile--{{ block.settings.block_alignment | default: 'left' }}"
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.block_image == blank -%}
                {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg feature-tile__image' }}
              {%- else -%}
                {{
                  block.settings.block_image
                  | image_url: width: 1400
                  | image_tag:
                    class: 'feature-tile__image',
                    widths: '400, 600, 800, 1000, 1400',
                    sizes: '(min-width: 990px) 50vw, 100vw',
                    loading: 'lazy',
                    alt: block.settings.block_image.alt
                }}
              {%- endif -%}
              <div class="feature-tile__caption tro-glass--strong">
                {%- if block.settings.announcement_checkbox and block.settings.announcement_text != blank -%}
                  <p class="feature-tile__eyebrow">{{ block.settings.announcement_text }}</p>
                {%- endif -%}
                {%- if block.settings.title != blank -%}
                  <h3 class="feature-tile__title">{{ block.settings.title }}</h3>
                {%- endif -%}
                {%- if block.settings.button_label != blank -%}
                  <span class="feature-tile__cta">
                    {{ block.settings.button_label }}
                    {% render 'icon-arrow' %}
                  </span>
                {%- endif -%}
              </div>
            </{{ tile_tag }}>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.feature_block.name",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "image_height",
      "options": [
        {
          "value": "small",
          "label": "t:sections.feature_block.settings.image_width.options__1.label"
        },
        {
          "value": "medium",
          "label": "t:sections.feature_block.settings.image_width.options__2.label"
        },
        {
          "value": "large",
          "label": "t:sections.feature_block.settings.image_width.options__3.label"
        }
      ],
      "default": "medium",
      "label": "t:sections.feature_block.settings.image_width.label",
      "info": "t:sections.feature_block.settings.image_width.info"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "t:sections.feature_block.blocks.feature.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "block_image",
          "label": "Image"
        },
        {
          "type": "select",
          "id": "block_alignment",
          "label": "t:sections.feature_block.blocks.feature.settings.block_alignment.title",
          "options": [
            {
              "value": "left",
              "label": "t:sections.feature_block.blocks.feature.settings.block_alignment.options__1.label"
            },
            {
              "value": "center",
              "label": "t:sections.feature_block.blocks.feature.settings.block_alignment.options__2.label"
            },
            {
              "value": "right",
              "label": "t:sections.feature_block.blocks.feature.settings.block_alignment.options__3.label"
            }
          ],
          "default": "left"
        },
        {
          "type": "checkbox",
          "id": "announcement_checkbox",
          "label": "t:sections.feature_block.blocks.feature.settings.announcement_checkbox.label",
          "default": true
        },
        {
          "type": "text",
          "id": "announcement_text",
          "label": "t:sections.feature_block.blocks.feature.settings.announcement_text.label",
          "default": "Announcement"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.feature_block.blocks.feature.settings.title.label",
          "default": "Feature Title"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "t:sections.feature_block.blocks.feature.settings.button_label.label",
          "default": "Click Here"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "t:sections.feature_block.blocks.feature.settings.button_link.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.feature_block.presets.name",
      "blocks": [
        {
          "type": "column"
        },
        {
          "type": "column"
        }
      ]
    }
  ]
}
{% endschema %}
