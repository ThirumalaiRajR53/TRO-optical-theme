{{ 'section-banner.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign layout = section.settings.layout | default: 'split'
  assign heading_tag = 'h1'
  if section.index > 1
    assign heading_tag = 'h2'
  endif
  assign image_alt = section.settings.image.alt | escape
-%}

{%- capture banner_blocks -%}
  {%- for block in section.blocks -%}
    {%- case block.type -%}
      {%- when 'heading' -%}
        <{{ heading_tag }} class="banner__heading" {{ block.shopify_attributes }}>{{ block.settings.heading }}</{{ heading_tag }}>
      {%- when 'text' -%}
        <p class="banner__lede" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
      {%- when 'text_2' -%}
        {%- comment -%} Short lines read as an eyebrow above the heading; sentences stay a secondary paragraph {%- endcomment -%}
        {%- assign text_2_plain = block.settings.text_2 | strip_html -%}
        {%- if text_2_plain.size <= 40 -%}
          <p class="banner__eyebrow" {{ block.shopify_attributes }}>{{ block.settings.text_2 }}</p>
        {%- else -%}
          <p class="banner__lede banner__lede--secondary" {{ block.shopify_attributes }}>{{ block.settings.text_2 }}</p>
        {%- endif -%}
      {%- when 'buttons' -%}
        <div class="banner__buttons" {{ block.shopify_attributes }}>
          {%- if block.settings.button_label_1 != blank -%}
            <a
              {% if block.settings.button_link_1 == blank %}
                role="link" aria-disabled="true"
              {% else %}
                href="{{ block.settings.button_link_1 }}"
              {% endif %}
              class="button button--primary banner__button"
            >
              {{- block.settings.button_label_1 | escape -}}
            </a>
          {%- endif -%}
          {%- if block.settings.button_label_2 != blank -%}
            <a
              {% if block.settings.button_link_2 == blank %}
                role="link" aria-disabled="true"
              {% else %}
                href="{{ block.settings.button_link_2 }}"
              {% endif %}
              class="button banner__button banner__button--glass"
            >
              {{- block.settings.button_label_2 | escape -}}
            </a>
          {%- endif -%}
        </div>
    {%- endcase -%}
  {%- endfor -%}
{%- endcapture -%}

<section
  id="Banner-{{ section.id }}"
  class="banner-wrapper banner-wrapper--{{ layout }}{% if section.settings.image == blank %} banner-wrapper--no-image{% endif %}"
>
  {%- if layout == 'full' -%}
    <div class="banner__media banner__media--full banner__media--focus-{{ section.settings.image_focus | default: 'center' }}">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 2400
          | image_tag:
            class: 'banner__image',
            widths: '600, 900, 1200, 1600, 2000, 2400',
            sizes: '100vw',
            loading: 'eager',
            fetchpriority: 'high',
            alt: image_alt
        }}
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg banner__image' }}
      {%- endif -%}
    </div>
    <div class="banner__scrim" aria-hidden="true"></div>
    <div class="page-width banner__inner banner__inner--full">
      <div class="banner__card tro-glass">
        {{ banner_blocks }}
      </div>
    </div>
  {%- else -%}
    <div class="page-width banner__inner banner__inner--split">
      <div class="banner__content">
        {{ banner_blocks }}
      </div>
      <div class="banner__media banner__media--split">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1500
            | image_tag:
              class: 'banner__image',
              widths: '400, 600, 800, 1000, 1200, 1500',
              sizes: '(min-width: 750px) 50vw, 100vw',
              loading: 'eager',
              fetchpriority: 'high',
              alt: image_alt
          }}
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg banner__image' }}
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "t:sections.banner.name",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.banner.settings.image.label"
    },
    {
      "type": "select",
      "id": "layout",
      "options": [
        {
          "value": "split",
          "label": "Text beside image"
        },
        {
          "value": "full",
          "label": "Full-width image with glass panel"
        }
      ],
      "default": "split",
      "label": "Layout"
    },
    {
      "type": "select",
      "id": "image_focus",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" },
        { "value": "top", "label": "Top" }
      ],
      "default": "center",
      "label": "Image focal point",
      "info": "Used by the full-width layout"
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "t:sections.banner.blocks.heading.name",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "LOOK DIFFERENT",
          "label": "t:sections.banner.blocks.heading.settings.heading.label"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.banner.blocks.text.name",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "default": "Freedom to Choose",
          "label": "t:sections.banner.blocks.text.settings.text.label"
        }
      ]
    },
    {
      "type": "text_2",
      "name": "t:sections.banner.blocks.text_2.name",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text_2",
          "default": "Prescription Frames & Sunglasses",
          "label": "t:sections.banner.blocks.text.settings.text.label"
        }
      ]
    },
    {
      "type": "buttons",
      "name": "t:sections.banner.blocks.buttons.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "button_label_1",
          "default": "Button label",
          "label": "t:sections.banner.blocks.buttons.settings.button_label_1.label"
        },
        {
          "type": "url",
          "id": "button_link_1",
          "label": "t:sections.banner.blocks.buttons.settings.button_link_1.label"
        },
        {
          "type": "text",
          "id": "button_label_2",
          "default": "Button label",
          "label": "Second button label",
          "info": "t:sections.banner.blocks.buttons.settings.button_label_2.label"
        },
        {
          "type": "url",
          "id": "button_link_2",
          "label": "t:sections.banner.blocks.buttons.settings.button_link_1.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.banner.presets.name",
      "blocks": [
        {
          "type": "heading"
        },
        {
          "type": "text"
        },
        {
          "type": "text_2"
        },
        {
          "type": "buttons"
        }
      ]
    }
  ]
}
{% endschema %}
