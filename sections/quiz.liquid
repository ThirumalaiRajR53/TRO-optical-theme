{{ 'section-main-quiz.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="quiz-cta{% if section.settings.image == blank %} quiz-cta--no-image{% endif %}">
      {% if section.settings.image != blank %}
        {{
          section.settings.image
          | image_url: width: 2000
          | image_tag:
            class: 'quiz-cta__image',
            widths: '600, 900, 1200, 1600, 2000',
            sizes: '(min-width: 1400px) 1300px, 100vw',
            loading: 'lazy',
            alt: ''
        }}
      {% endif %}
      <div class="quiz-cta__card tro-glass--strong quiz-info">
        <p class="quiz-cta__eyebrow">{{ 'quiz.frame_finder' | t }}</p>
        <h2 class="quiz-cta__heading">{{ section.settings.heading }}</h2>
        <div class="quiz-cta__text rte">{{ section.settings.description }}</div>
        {%- if section.settings.button_label != blank -%}
          <div>
            <a
              {% if section.settings.button_link == blank %}
                role="link" aria-disabled="true"
              {% else %}
                href="{{ section.settings.button_link }}"
              {% endif %}
              class="button button--primary quiz-cta__button"
            >
              {{- section.settings.button_label | escape -}}
            </a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.quiz.name",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.quiz.settings.image.label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.quiz.settings.heading.label",
      "default": "Find Your Best Match"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:sections.quiz.settings.description.label",
      "default": "<p>Need help looking for your perfect Readers, Sunglasses or Blue Light Filtering Eyewear? Take our quiz to find the best fit for you.<\/p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.quiz.settings.button_label.label",
      "default": "Take the quiz"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.quiz.settings.button_link.label"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "t:sections.quiz.presets.name"
    }
  ]
}
{% endschema %}
